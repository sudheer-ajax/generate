{
  "batchSize": 20,
  "allowedFileExtensions": ["pdf"],
  "exportTargets": [
    {
      "label": "CIF",
      "matchNames": ["CIF"],
      "matchPatterns": ["^CIF\\s*\\([^)]+\\)$"]
    },
    {
      "label": "SALIE",
      "matchNames": ["SALIE", "Salie"],
      "matchPatterns": ["\\bSALIE\\b"]
    },
    {
      "label": "Application_Form",
      "matchPatterns": ["Application\\s+Form"]
    },
    {
      "label": "Valuation_Report",
      "matchNames": ["Valuation Report"],
      "matchPatterns": ["Valuation\\s+Report"]
    },
    {
      "label": "Credit_Memo",
      "matchNames": ["Credit Memo"],
      "matchPatterns": ["Credit\\s+Memo"]
    }
  ],
  "excludeNamePatterns": [],
  "collateralExport": {
    "residentialOnly": true,
    "collateralTypeIncludes": "Residential",
    "requireAddress": true
  },
  "_comment": "exportTargets: matchNames and matchPatterns are case-insensitive (document LLC_BI__*Document__c Name). collateralExport: npm run collateral:batch."
}
