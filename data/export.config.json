{
  "batchSize": 20,
  "allowedFileExtensions": [],
  "exportTargets": [
    {
      "label": "CIF",
      "matchNames": ["CIF"],
      "matchPatterns": ["^CIF\\s*\\([^)]+\\)$"]
    },
    {
      "label": "SALIE",
      "matchNames": ["SALIE", "Salie"],
      "matchPatterns": ["\\bSALIE\\b"]
    },
    {
      "label": "Application_Form",
      "matchPatterns": ["Application\\s+Form"]
    },
    {
      "label": "Valuation_Report",
      "matchNames": ["Valuation Report"],
      "matchPatterns": ["Valuation\\s+Report"]
    },
    {
      "label": "Credit_Memo",
      "matchNames": ["Credit Memo"],
      "matchPatterns": ["Credit\\s+Memo"]
    }
  ],
  "excludeNamePatterns": [],
  "collateralExport": {
    "residentialOnly": true,
    "collateralTypeIncludes": "Residential",
    "requireAddress": true
  },
  "_comment": "allowedFileExtensions: [] = download any file type when name matches; e.g. [\"pdf\"] to restrict. exportTargets names are case-insensitive. collateralExport: npm run collateral:batch."
}
