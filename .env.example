# HTTP server
PORT=3000

# Salesforce / nCino
# OAuth token host (sandbox: test.salesforce.com — NOT My Domain URL)
SF_LOGIN_URL=https://test.salesforce.com
# Org host after login (e.g. https://yourorg--sandbox.sandbox.my.salesforce.com)
SF_INSTANCE_URL=
# oauth | soap | token | refresh
SF_AUTH_MODE=soap
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_ACCESS_TOKEN=
SF_REFRESH_TOKEN=
SF_API_VERSION=60.0

# Mambu API v2 (optional, future)
MAMBU_BASE_URL=
MAMBU_API_KEY=
MAMBU_NCINO_LOAN_NAME_FIELD=ncino_loan_name

# Batch document export (npm run docs:batch)
EXPORT_LOAN_IDS_FILE=data/loan-ids.txt
EXPORT_CONFIG_FILE=data/export.config.json
EXPORT_LOCAL_DIR=output/documents
AWS_S3_BUCKET=
AWS_S3_PREFIX=ncino-loan-documents
AWS_REGION=eu-west-2

# Legacy BOE preview only (npm run legacy:boe-preview)
BOE_CUTOFF_DATE=
BOE_POOL_ID=
BOE_ORIGINATOR_NAME=
BOE_SERVICER_ID=
